# ─── MeowChat Engine — Environment Variables ─────────────────────────────────

# Server
PORT=3100

# Redis (local or Redis Cloud / Upstash)
REDIS_URL=redis://localhost:6379

# Google Gemini
GEMINI_API_KEY=AIza...

# LINE OA (per bot — or store per-bot in DB)
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Admin API key (protect /admin/* routes)
ADMIN_API_KEY=change-me-in-production

# Dev helpers
REGISTER_DEMO=1   # set to 1 to auto-register demo bot on startup
